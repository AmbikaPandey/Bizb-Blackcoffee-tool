# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/bizb

# ─── Authentication ───────────────────────────────────────
SESSION_EXPIRY_HOURS=24

# ─── Client URL (frontend origin for CORS) ────────────────
CLIENT_URL=http://localhost:5173

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ─── SMTP (email — optional) ──────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@yourdomain.com

# ─── BUSY Integration (optional) ─────────────────────────
BUSY_EXPORT_DIR=./exports/busy

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=debug
